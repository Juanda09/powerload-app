<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#07090d</item>

        <!-- ícono vacío/transparente en vez de tu logo grande -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>

        <item name="postSplashScreenTheme">
            @style/AppTheme.NoActionBar
        </item>

        <!-- esto es lo que realmente muestra tu imagen completa -->
        <item name="android:windowBackground">@drawable/splash_full</item>

    </style>

</resources>